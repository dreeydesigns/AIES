{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the AIES platform",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["student", "teacher", "parent", "admin"] },
        "points": { "type": "number" },
        "level": { "type": "number" },
        "streak": { "type": "number" },
        "childIds": { "type": "array", "items": { "type": "string" } },
        "completedLessons": { "type": "array", "items": { "type": "string" } },
        "earnedBadges": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name", "role"]
    },
    "Course": {
      "title": "Course",
      "description": "An educational course",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 }
      },
      "required": ["title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles and progress"
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Available courses"
    }
  }
}
